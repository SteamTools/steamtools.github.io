/cards/*.css
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/itemvalue/*.js
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/itemvalue/*.css
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/games/*.js
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/games/*.css
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/emoticons/*.js
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/emoticons/*.css
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/backgrounds/*.js
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/backgrounds/*.css
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/mosaticon/*.js
